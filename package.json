{
  "name": "tenet-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "seed": "npx tsx scripts/seed-sanity.ts",
    "remotion:preview": "remotion preview remotion/index.ts",
    "remotion:render": "remotion render remotion/index.ts MasterViralReel out/master-viral-reel.mp4",
    "remotion:render:chocolate": "remotion render remotion/index.ts ChocolateAndDenimSet out/chocolate-denim-outfit.mp4",
    "remotion:render:blue": "remotion render remotion/index.ts BlueAndDenimSet out/blue-denim-outfit.mp4",
    "remotion:render:red": "remotion render remotion/index.ts RedAndDenimSet out/red-denim-outfit.mp4",
    "remotion:render:yellow": "remotion render remotion/index.ts YellowAndDenimSet out/yellow-denim-viral.mp4",
    "remotion:render:pink": "remotion render remotion/index.ts PinkAndDenimSet out/pink-denim-viral.mp4",
    "remotion:render:all-outfits": "npm run remotion:render:chocolate && npm run remotion:render:blue && npm run remotion:render:red && npm run remotion:render:yellow && npm run remotion:render:pink",
    "publish:youtube": "npx tsx scripts/publisher/index.ts --platform=youtube",
    "publish:instagram": "npx tsx scripts/publisher/index.ts --platform=instagram",
    "publish:all": "npx tsx scripts/publisher/index.ts --platform=all",
    "remotion:still": "remotion still remotion/index.ts ChocolateAndDenimSet out/preview.png"
  },
